<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Mystery Gift Reveal</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background: linear-gradient(135deg, #1a1c29 0%, #10111a 100%);
            color: #ffffff;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            overscroll-behavior-y: contain;
            overscroll-behavior: none;
        }

        .container {
            text-align: center;
            padding: 16px;
            z-index: 2;
            width: 100%;
            max-width: 460px;
        }

        h1 {
            font-size: 1.8rem;
            margin-bottom: 6px;
            background: linear-gradient(45deg, #ff416c, #ff4b2b);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-shadow: 0 0 25px rgba(255, 65, 108, 0.3);
        }

        p.subtitle {
            color: #8a8dbe;
            margin-bottom: 16px;
            font-size: 0.95rem;
            min-height: 38px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Bill Input Section */
        .bill-input-card {
            margin-bottom: 18px;
            display: flex;
            justify-content: center;
            gap: 10px;
        }

        .bill-input-card input {
            background: #25283d;
            border: 1px solid #414568;
            color: #fff;
            padding: 10px 14px;
            border-radius: 8px;
            font-size: 0.95rem;
            outline: none;
            width: 160px;
        }

        .bill-input-card button {
            background: linear-gradient(45deg, #ff416c, #ff4b2b);
            border: none;
            color: white;
            padding: 10px 18px;
            border-radius: 8px;
            font-size: 0.95rem;
            font-weight: 600;
            cursor: pointer;
            transition: transform 0.2s ease;
        }

        .bill-input-card button:hover {
            transform: scale(1.05);
        }

        /* ==================== TREASURE CHEST DESIGN & ANIMATION ==================== */
        .chest-stage {
            display: flex;
            flex-direction: column;
            align-items: center;
            transition: opacity 0.4s ease, transform 0.4s ease;
        }

        .chest-stage.hide {
            display: none;
        }

        .gift-container {
            position: relative;
            width: 180px;
            height: 160px;
            margin: 0 auto;
            cursor: pointer;
            perspective: 800px;
            -webkit-tap-highlight-color: transparent;
            flex-shrink: 0;
        }

        .gift-container::after {
            content: '';
            position: absolute;
            bottom: 2px;
            left: 50%;
            transform: translateX(-50%);
            width: 160px;
            height: 22px;
            background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.75) 0%, rgba(212, 175, 55, 0.2) 40%, transparent 75%);
            border-radius: 50%;
            z-index: 1;
        }

        .gift-box {
            position: relative;
            width: 160px;
            height: 90px;
            margin: 55px auto 0 auto;
            background: repeating-linear-gradient(
                180deg,
                #6e3a17 0px,
                #50260c 18px,
                #371906 20px
            );
            border-radius: 0 0 12px 12px;
            border: 3px solid #2b1305;
            box-shadow: inset 0 -10px 25px rgba(0, 0, 0, 0.7), 0 14px 26px rgba(0, 0, 0, 0.6);
            transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
            z-index: 2;
        }

        .gift-box::before {
            content: '';
            position: absolute;
            top: 0;
            left: 18px;
            width: 16px;
            height: 100%;
            background: linear-gradient(90deg, #8a6a1c, #ffd700 50%, #94721d);
            border-left: 2px solid #3d2a03;
            border-right: 2px solid #3d2a03;
            box-shadow: 92px 0 0 0 #ffd700, 90px 0 0 2px #3d2a03;
        }

        .gift-box::after {
            content: '';
            position: absolute;
            top: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 28px;
            height: 32px;
            background: radial-gradient(circle at 50% 30%, #fff2a3 0%, #d4af37 60%, #856404 100%);
            border: 2px solid #382500;
            border-radius: 6px 6px 14px 14px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.5), inset 0 2px 4px rgba(255,255,255,0.6);
            z-index: 5;
        }

        .gift-lid {
            position: absolute;
            top: 15px;
            left: 5px;
            width: 170px;
            height: 48px;
            background: repeating-linear-gradient(
                180deg,
                #85451c 0px,
                #5e2d0e 16px,
                #3a1a06 18px
            );
            border-radius: 34px 34px 6px 6px;
            border: 3px solid #2b1305;
            box-shadow: inset 0 6px 15px rgba(255, 255, 255, 0.2), 0 8px 18px rgba(0, 0, 0, 0.5);
            z-index: 4;
            transform-origin: center top;
            transition: transform 0.8s cubic-bezier(0.2, 0.85, 0.3, 1.25);
            transform-style: preserve-3d;
        }

        .gift-lid::before {
            content: '';
            position: absolute;
            top: 0;
            left: 20px;
            width: 18px;
            height: 100%;
            background: linear-gradient(90deg, #8a6a1c, #ffd700 50%, #94721d);
            border-left: 2px solid #3d2a03;
            border-right: 2px solid #3d2a03;
            border-radius: 18px 18px 0 0;
            box-shadow: 94px 0 0 0 #ffd700, 92px 0 0 2px #3d2a03;
        }

        .gift-lid::after {
            content: '';
            position: absolute;
            top: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 30px;
            height: 14px;
            border: 3px solid #d4af37;
            border-bottom: none;
            border-radius: 10px 10px 0 0;
            box-shadow: 0 0 8px rgba(212, 175, 55, 0.6);
        }

        .gift-container.shake .gift-box {
            animation: chestRattle 0.4s ease-in-out infinite;
        }

        .gift-container.shake .gift-lid {
            animation: lidRattle 0.4s ease-in-out infinite;
        }

        .gift-container.opened .gift-lid {
            transform: translateY(-12px) rotateX(-115deg);
        }

        .gift-container.opened .gift-box {
            box-shadow: inset 0 20px 35px #ffe600, 0 15px 40px rgba(255, 215, 0, 0.6);
        }

        @keyframes chestRattle {
            0%, 100% { transform: translateX(0) rotate(0deg); }
            20% { transform: translateX(-5px) rotate(-1.5deg); }
            40% { transform: translateX(5px) rotate(1.5deg); }
            60% { transform: translateX(-3px) rotate(-1deg); }
            80% { transform: translateX(3px) rotate(1deg); }
        }

        @keyframes lidRattle {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            30% { transform: translateY(-4px) rotate(-2deg); }
            70% { transform: translateY(-2px) rotate(2deg); }
        }

        /* Single Live Gift Reveal */
        .single-reveal {
            margin-top: 14px;
            opacity: 0;
            transform: translateY(10px) scale(0.9);
            transition: all 0.3s cubic-bezier(0.2, 0.9, 0.3, 1.2);
            pointer-events: none;
            min-height: 52px;
        }

        .single-reveal.show {
            opacity: 1;
            transform: translateY(0) scale(1);
        }

        .current-prize-pill {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.1) 0%, rgba(255, 255, 255, 0.04) 100%);
            border: 1px solid rgba(255, 215, 0, 0.4);
            padding: 8px 18px;
            border-radius: 30px;
            font-size: 1.15rem;
            font-weight: 800;
            color: #fff;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4), inset 0 0 12px rgba(255, 215, 0, 0.15);
        }

        .badge-current {
            background: linear-gradient(45deg, #ffd700, #ff9900);
            color: #201400;
            font-size: 0.75rem;
            font-weight: 900;
            padding: 3px 8px;
            border-radius: 12px;
            text-transform: uppercase;
        }

        /* ==================== FINAL ALL-GIFTS SUMMARY (NO SCROLL GRID) ==================== */
        .summary-card {
            display: none;
            opacity: 0;
            transform: scale(0.92);
            transition: all 0.5s cubic-bezier(0.2, 0.9, 0.3, 1.2);
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 215, 0, 0.25);
            border-radius: 16px;
            padding: 16px 12px;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.5);
        }

        .summary-card.show {
            display: block;
            opacity: 1;
            transform: scale(1);
        }

        .summary-title {
            font-size: 1.1rem;
            color: #00ffd0;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 12px;
            text-shadow: 0 0 12px rgba(0, 255, 208, 0.5);
        }

        /* 2-column compact grid fitting up to 10+ prizes without page scrolling */
        .summary-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 8px;
        }

        .summary-item {
            display: flex;
            align-items: center;
            gap: 6px;
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 215, 0, 0.3);
            border-radius: 8px;
            padding: 6px 8px;
            font-size: 0.85rem;
            font-weight: 700;
            text-align: left;
            animation: popIn 0.3s ease forwards;
        }

        .summary-badge {
            background: linear-gradient(45deg, #ffd700, #ff9900);
            color: #201400;
            font-size: 0.65rem;
            font-weight: 900;
            padding: 2px 5px;
            border-radius: 6px;
            white-space: nowrap;
        }

        .summary-name {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            color: #ffffff;
        }

        @keyframes popIn {
            0% { transform: scale(0.85); opacity: 0; }
            100% { transform: scale(1); opacity: 1; }
        }

        .disabled {
            cursor: not-allowed !important;
            opacity: 0.6;
        }
    </style>
</head>
<body>

    <div class="container">
        <h1>GLAMOUR REWARDS</h1>
        <p class="subtitle" id="status-text">Enter bill amount to unlock gifts (1 Gift per ₹1000)</p>

        <!-- Bill Amount Input -->
        <div class="bill-input-card" id="billInputSection">
            <input type="number" id="billAmount" placeholder="Enter Bill (₹)" min="0">
            <button onclick="setBillAmount()">Submit Bill</button>
        </div>

        <!-- Single Chest Stage -->
        <div class="chest-stage" id="chestStage">
            <div class="gift-container" id="giftContainer" onclick="openGift()">
                <div class="gift-lid" id="giftLid"></div>
                <div class="gift-box"></div>
            </div>

            <div class="single-reveal" id="singleReveal">
                <div class="current-prize-pill" id="currentPrizeContent"></div>
            </div>
        </div>

        <!-- Final Summary View (Reveals after ALL gifts are opened) -->
        <div class="summary-card" id="summaryCard">
            <p class="summary-title">🎉 All Won Rewards 🎉</p>
            <div class="summary-grid" id="summaryGrid"></div>
        </div>
    </div>

    <script>
        const defaultGifts = [
            { name: "MAGIC LED BULB", weight: 20 },
            { name: "WATER BOTTLE",   weight: 20 },
            { name: "COFFEE MUG",    weight:  0 },
            { name: "CUP SET",       weight:  0 },
            { name: "LADIES BAG",    weight: 25 },
            { name: "UMBRELLA",      weight: 10 },
            { name: "TRAY",          weight: 20 },
            { name: "GENTS BAG",     weight: 10 },
            { name: "WALL CLOCK",    weight:  8 },
            { name: "WRIST WATCH",   weight:  0 },
            { name: "FAN",           weight:  0 }
        ];

        const oneTimeItems = ["WALL CLOCK", "CUP SET", "LADIES BAG", "FAN"];

        let currentGiftPool = [];
        let totalEligibleGifts = 0;
        let giftsRevealedCount = 0;
        let wonGiftsList = [];
        let isOpening = false;

        function setBillAmount() {
            const billInput = document.getElementById('billAmount');
            const amount = parseFloat(billInput.value);
            const statusText = document.getElementById('status-text');

            if (isNaN(amount) || amount < 1000) {
                alert("Minimum bill amount must be ₹1000 to earn a gift!");
                return;
            }

            totalEligibleGifts = Math.floor(amount / 1000);
            giftsRevealedCount = 0;
            wonGiftsList = [];

            currentGiftPool = JSON.parse(JSON.stringify(defaultGifts));

            const clockRef = currentGiftPool.find(g => g.name === "WALL CLOCK");
            if (clockRef) {
                clockRef.weight = (amount >= 1000 && amount <= 2999) ? 3 : 8;
            }

            document.getElementById('billInputSection').style.display = 'none';
            statusText.textContent = `Unlocked ${totalEligibleGifts} gift(s)! Tap chest for Gift #1.`;
            document.getElementById('giftContainer').classList.remove('disabled');
        }

        window.addEventListener('beforeunload', function (e) {
            e.preventDefault();
            e.returnValue = 'Reward state will be lost.';
        });

        window.addEventListener('keydown', function (e) {
            if (e.key === 'F5' || (e.ctrlKey && e.key === 'r') || (e.metaKey && e.key === 'r')) {
                e.preventDefault();
            }
        });

        let touchStartClientY = 0;
        window.addEventListener('touchstart', function (e) {
            if (e.touches.length === 1) touchStartClientY = e.touches[0].clientY;
        }, { passive: false });

        window.addEventListener('touchmove', function (e) {
            const touchDistanceY = e.touches[0].clientY - touchStartClientY;
            if (window.scrollY === 0 && touchDistanceY > 0) e.preventDefault();
        }, { passive: false });

        function getWeightedGift() {
            const totalWeight = currentGiftPool.reduce((sum, item) => sum + item.weight, 0);
            let selectedItemName = defaultGifts[0].name;

            if (totalWeight <= 0) {
                const fallbackGifts = ["MAGIC LED BULB", "WATER BOTTLE", "TRAY"];
                selectedItemName = fallbackGifts[Math.floor(Math.random() * fallbackGifts.length)];
            } else {
                let random = Math.random() * totalWeight;
                for (const gift of currentGiftPool) {
                    if (random < gift.weight) {
                        selectedItemName = gift.name;
                        break;
                    }
                    random -= gift.weight;
                }
            }

            if (oneTimeItems.includes(selectedItemName)) {
                const itemRef = currentGiftPool.find(g => g.name === selectedItemName);
                if (itemRef) itemRef.weight = 0;
            }

            return selectedItemName;
        }

        function openGift() {
            if (totalEligibleGifts === 0) {
                alert("Please enter a valid bill amount first!");
                return;
            }

            if (isOpening || giftsRevealedCount >= totalEligibleGifts) return;
            isOpening = true;

            const container = document.getElementById('giftContainer');
            const statusText = document.getElementById('status-text');
            const singleReveal = document.getElementById('singleReveal');
            const currentPrizeContent = document.getElementById('currentPrizeContent');

            container.classList.remove('opened');
            singleReveal.classList.remove('show');

            container.classList.add('shake');
            statusText.textContent = `Unlocking chest ${giftsRevealedCount + 1} of ${totalEligibleGifts}...`;

            setTimeout(() => {
                container.classList.remove('shake');
                container.classList.add('opened');

                const winningPrize = getWeightedGift();
                giftsRevealedCount++;
                wonGiftsList.push(winningPrize);

                // Show only the latest prize under the chest
                currentPrizeContent.innerHTML = `
                    <span class="badge-current">Gift #${giftsRevealedCount}</span>
                    <span>${winningPrize}</span>
                `;
                singleReveal.classList.add('show');

                if (giftsRevealedCount < totalEligibleGifts) {
                    statusText.textContent = `Claimed Gift #${giftsRevealedCount}! Tap chest again for #${giftsRevealedCount + 1}.`;
                    isOpening = false;
                } else {
                    statusText.textContent = "All gifts revealed! Here is your complete summary:";
                    isOpening = false;

                    // After 1.2s delay, swap out chest and reveal full 2-column no-scroll grid
                    setTimeout(() => {
                        document.getElementById('chestStage').classList.add('hide');
                        const summaryCard = document.getElementById('summaryCard');
                        const summaryGrid = document.getElementById('summaryGrid');

                        summaryGrid.innerHTML = wonGiftsList.map((item, idx) => `
                            <div class="summary-item">
                                <span class="summary-badge">#${idx + 1}</span>
                                <span class="summary-name">${item}</span>
                            </div>
                        `).join('');

                        summaryCard.classList.add('show');
                    }, 1200);
                }
            }, 1100);
        }
    </script>
</body>
</html>
